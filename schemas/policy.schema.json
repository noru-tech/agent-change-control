{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/noru-tech/agent-change-control/main/schemas/policy.schema.json",
  "$ref": "#/$defs/policy",
  "$defs": {
    "rule_policy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "severity": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "warning",
            "info"
          ]
        }
      },
      "required": [
        "enabled",
        "severity"
      ],
      "additionalProperties": false
    },
    "agent_review": {
      "type": "object",
      "properties": {
        "satisfies_independence": {
          "type": "boolean"
        },
        "require": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "operator",
              "provider",
              "identity",
              "instructions"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "minimum_evidence": {
          "type": "string",
          "enum": [
            "signed"
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "enum": [
            "0.1",
            "0.2"
          ]
        },
        "fail_on": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "warning",
            "info"
          ]
        },
        "minimum_authorship_evidence": {
          "type": "string",
          "enum": [
            "derived",
            "declared",
            "observed",
            "signed"
          ]
        },
        "minimum_review_evidence": {
          "type": "string",
          "enum": [
            "derived",
            "declared",
            "observed",
            "signed"
          ]
        },
        "agent_review": {
          "$ref": "#/$defs/agent_review"
        },
        "rules": {
          "type": "object",
          "properties": {
            "agent_change_without_independent_human": {
              "$ref": "#/$defs/rule_policy"
            },
            "approver_is_author": {
              "$ref": "#/$defs/rule_policy"
            },
            "merged_without_independent_approval": {
              "$ref": "#/$defs/rule_policy"
            },
            "unknown_agent_operator": {
              "$ref": "#/$defs/rule_policy"
            },
            "agent_approval_recorded": {
              "$ref": "#/$defs/rule_policy"
            },
            "same_vendor_write_and_review": {
              "$ref": "#/$defs/rule_policy"
            },
            "agent_approval_not_independent": {
              "$ref": "#/$defs/rule_policy"
            },
            "agent_approval_unsigned": {
              "$ref": "#/$defs/rule_policy"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "rules"
      ],
      "additionalProperties": false
    }
  }
}
