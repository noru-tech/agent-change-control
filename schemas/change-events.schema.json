{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noru.tech/spec/ai-change-provenance/v0.4/change-events.schema.json",
  "$ref": "#/$defs/events",
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "observed",
            "derived",
            "declared",
            "signed"
          ]
        }
      },
      "required": [
        "source",
        "ref",
        "kind"
      ],
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "bot",
            "service",
            "unknown"
          ]
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "vendor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "display_name"
      ],
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        },
        "complete": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "from",
        "to",
        "complete",
        "reason"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "actor_id",
        "provenance"
      ],
      "additionalProperties": false
    },
    "operator": {
      "type": "object",
      "properties": {
        "actor_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "explicit",
            "derived",
            "unknown"
          ]
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "actor_id",
        "confidence",
        "provenance"
      ],
      "additionalProperties": false
    },
    "review_agent": {
      "type": "object",
      "properties": {
        "operator": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "identity": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "instructions_owner": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operator",
        "identity",
        "instructions_owner",
        "model"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "approved",
            "changes_requested",
            "dismissed",
            "commented"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "commit_sha": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/review_agent"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "actor_id",
        "state",
        "at",
        "commit_sha",
        "provenance"
      ],
      "additionalProperties": false
    },
    "commit": {
      "type": "object",
      "properties": {
        "sha": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sha",
        "author"
      ],
      "additionalProperties": false
    },
    "check_run": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "check_run",
            "job",
            "pipeline",
            "status"
          ]
        },
        "commit_sha": {
          "type": "string",
          "minLength": 1
        },
        "conclusion": {
          "type": "string",
          "enum": [
            "action_required",
            "cancelled",
            "error",
            "failure",
            "neutral",
            "skipped",
            "stale",
            "success",
            "timed_out"
          ]
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "name",
        "kind",
        "commit_sha",
        "conclusion",
        "completed_at",
        "provenance"
      ],
      "additionalProperties": false
    },
    "checks": {
      "description": "Check and status results and the forge's required checks for a merged change (ACP 0.4, ACC004). `required` is what the forge's rules said at collection time.",
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check_run"
          }
        },
        "runs_complete": {
          "type": "boolean"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "branch_protection",
              "project_settings",
              "rules"
            ]
          }
        },
        "required_complete": {
          "type": "boolean"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "branch",
        "runs",
        "runs_complete",
        "required",
        "required_sources",
        "required_complete",
        "provenance"
      ],
      "additionalProperties": false
    },
    "rule_suite": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "after_sha": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "enum": [
            "bypass",
            "fail",
            "pass"
          ]
        },
        "actor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "pushed_at": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "id",
        "after_sha",
        "result",
        "actor",
        "pushed_at",
        "provenance"
      ],
      "additionalProperties": false
    },
    "protection": {
      "description": "Ruleset evaluations of the push that landed a merged change's merge commit (ACP 0.4, ACC005).",
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "suites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule_suite"
          }
        },
        "complete": {
          "type": "boolean"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "branch",
        "suites",
        "complete",
        "provenance"
      ],
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "forge": {
          "type": "string",
          "enum": [
            "github",
            "gitlab"
          ]
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "opened_at": {
          "type": "string",
          "format": "date-time"
        },
        "merged_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "head_sha": {
          "type": "string",
          "minLength": 1
        },
        "merge_commit_sha": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "commits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commit"
          }
        },
        "forge_author": {
          "$ref": "#/$defs/identity"
        },
        "author": {
          "$ref": "#/$defs/identity"
        },
        "agent_operator": {
          "anyOf": [
            {
              "$ref": "#/$defs/operator"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review"
          }
        },
        "reviews_complete": {
          "type": "boolean"
        },
        "merger": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "$ref": "#/$defs/checks"
        },
        "protection": {
          "$ref": "#/$defs/protection"
        },
        "risk": {
          "$ref": "#/$defs/risk"
        }
      },
      "required": [
        "id",
        "repository",
        "forge",
        "title",
        "url",
        "opened_at",
        "merged_at",
        "head_sha",
        "commits",
        "forge_author",
        "author",
        "agent_operator",
        "reviews",
        "reviews_complete",
        "merger",
        "provenance"
      ],
      "additionalProperties": false
    },
    "signer": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "identity",
        "issuer"
      ],
      "additionalProperties": false
    },
    "attestation": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "predicate_type": {
          "type": "string",
          "minLength": 1
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "signed": {
          "type": "boolean"
        },
        "verified_by": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "signer": {
          "anyOf": [
            {
              "$ref": "#/$defs/signer"
            },
            {
              "type": "null"
            }
          ]
        },
        "matched": {
          "type": "boolean"
        }
      },
      "required": [
        "file",
        "predicate_type",
        "payload_digest",
        "signed",
        "verified_by"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "enum": [
            "0.1",
            "0.2",
            "0.3",
            "0.4"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "actors": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/actor"
          }
        },
        "attestations": {
          "type": "object",
          "propertyNames": {
            "pattern": "^attestation:[a-f0-9]{16}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/attestation"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "teams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/team"
          }
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branch"
          }
        },
        "deployments": {
          "$ref": "#/$defs/deployments"
        }
      },
      "required": [
        "version",
        "repository",
        "window",
        "actors",
        "changes"
      ],
      "additionalProperties": false
    },
    "tier": {
      "type": "string",
      "enum": [
        "low",
        "standard",
        "high",
        "emergency"
      ]
    },
    "risk": {
      "description": "The change's risk tier, from a change-risk assessment bound to its head commit (ACP 0.4).",
      "type": "object",
      "properties": {
        "tier": {
          "$ref": "#/$defs/tier"
        },
        "emergency": {
          "type": "object",
          "properties": {
            "declared_by": {
              "type": "string",
              "minLength": 1
            },
            "declared_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "declared_by",
            "declared_at"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "tier",
        "provenance"
      ],
      "additionalProperties": false
    },
    "team": {
      "description": "A reviewer team and its members as observed at collection, not at review time (ACP 0.4).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+(/[a-z0-9_.-]+)+$"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "complete": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "members",
        "complete",
        "observed_at",
        "provenance"
      ],
      "additionalProperties": false
    },
    "branch_event": {
      "description": "One update of a protected branch, as the forge's activity record names it (ACP 0.4, ACC012).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "push",
            "force_push",
            "branch_creation",
            "branch_deletion",
            "pr_merge",
            "merge_queue_merge"
          ]
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "actor_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "before",
        "after",
        "at",
        "actor_id",
        "provenance"
      ],
      "additionalProperties": false
    },
    "branch": {
      "description": "A protected branch and its updates in the window (ACP 0.4, ACC012).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branch_event"
          }
        },
        "complete": {
          "type": "boolean"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "id",
        "name",
        "events",
        "complete",
        "provenance"
      ],
      "additionalProperties": false
    },
    "deployed_commit": {
      "type": "object",
      "properties": {
        "sha": {
          "type": "string",
          "minLength": 1
        },
        "committed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "sha",
        "committed_at"
      ],
      "additionalProperties": false
    },
    "deployment": {
      "description": "One successful deployment to a production environment (ACP 0.4, ACC013).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "creator": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "previous_sha": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "commits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deployed_commit"
          }
        },
        "commits_complete": {
          "type": "boolean"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "id",
        "environment",
        "sha",
        "at",
        "creator",
        "previous_sha",
        "commits",
        "commits_complete",
        "provenance"
      ],
      "additionalProperties": false
    },
    "deployments": {
      "description": "The production deployments in a deployment window (ACP 0.4, ACC013).",
      "type": "object",
      "properties": {
        "environments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        },
        "deployments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deployment"
          }
        },
        "complete": {
          "type": "boolean"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "environments",
        "from",
        "to",
        "deployments",
        "complete",
        "provenance"
      ],
      "additionalProperties": false
    }
  }
}
