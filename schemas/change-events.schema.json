{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/noru-tech/agent-change-control/main/schemas/change-events.schema.json",
  "$ref": "#/$defs/events",
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "observed",
            "derived",
            "declared"
          ]
        }
      },
      "required": [
        "source",
        "ref",
        "kind"
      ],
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "bot",
            "service",
            "unknown"
          ]
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "display_name"
      ],
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        },
        "complete": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "from",
        "to",
        "complete",
        "reason"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "actor_id",
        "provenance"
      ],
      "additionalProperties": false
    },
    "operator": {
      "type": "object",
      "properties": {
        "actor_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "explicit",
            "derived",
            "unknown"
          ]
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "actor_id",
        "confidence",
        "provenance"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "approved",
            "changes_requested",
            "dismissed",
            "commented"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "commit_sha": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "actor_id",
        "state",
        "at",
        "commit_sha",
        "provenance"
      ],
      "additionalProperties": false
    },
    "commit": {
      "type": "object",
      "properties": {
        "sha": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sha",
        "author"
      ],
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "forge": {
          "type": "string",
          "enum": [
            "github"
          ]
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "opened_at": {
          "type": "string",
          "format": "date-time"
        },
        "merged_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "head_sha": {
          "type": "string",
          "minLength": 1
        },
        "merge_commit_sha": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "commits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commit"
          }
        },
        "forge_author": {
          "$ref": "#/$defs/identity"
        },
        "author": {
          "$ref": "#/$defs/identity"
        },
        "agent_operator": {
          "anyOf": [
            {
              "$ref": "#/$defs/operator"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review"
          }
        },
        "reviews_complete": {
          "type": "boolean"
        },
        "merger": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "repository",
        "forge",
        "title",
        "url",
        "opened_at",
        "merged_at",
        "head_sha",
        "commits",
        "forge_author",
        "author",
        "agent_operator",
        "reviews",
        "reviews_complete",
        "merger",
        "provenance"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "properties": {
        "version": {
          "const": "0.1"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "actors": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/actor"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        }
      },
      "required": [
        "version",
        "repository",
        "window",
        "actors",
        "changes"
      ],
      "additionalProperties": false
    }
  }
}
